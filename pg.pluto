local { base64, crypto } = require "*"

if not crypto.hmac then
    function crypto.hmac(algo, key, data, binary)
        local block_bytes = switch algo do
            case "sha1", "sha256" -> 64
            case "sha384", "sha512" -> 128
        end

        if #key > block_bytes then
            key = crypto[algo](key, true)
        end
        if #key < block_bytes then
            key = key .. string.rep("\0", block_bytes - #key)
        end

        local inner = key:split(""):map(|x| -> string.char(string.byte(x) ~ 0x36)):concat("")
        local outer = key:split(""):map(|x| -> string.char(string.byte(x) ~ 0x5c)):concat("")

        inner ..= data

        inner = crypto[algo](inner, true)
        outer ..= inner
        outer = crypto[algo](outer, binary)
        return outer
    end
end
do
    local key = "\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b"
    assert(crypto.hmac("sha256", key, "Hi There") == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assert(crypto.hmac("sha256", key, "Hi There", false) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assert(crypto.hmac("sha256", key, "Hi There", true) == "\xb0\x34\x4c\x61\xd8\xdb\x38\x53\x5c\xa8\xaf\xce\xaf\x0b\xf1\x2b\x88\x1d\xc2\x00\xc9\x83\x3d\xa7\x26\xe9\x37\x6c\x2e\x32\xcf\xf7")
    assert(crypto.hmac("sha1", "plnlrtfpijpuhqylxbgqiiyipieyxvfsavzgxbbcfusqkozwpngsyejqlmjsytrmd", "\xA0\x09\xC1\xA4\x85\x91\x2C\x6A\xE6\x30\xD3\xE7\x44\x24\x0B\x04\x00\x00\x00\x01") == "c9b3082a25d4634b5e06260c5c790178cb152044")
end

function pbkdf2_hmac(algo, pass, salt, iterations, chunk = 1)
    local ui = crypto.hmac(algo, pass, salt .. string.pack(">I4", chunk), true)
    local result = ui:split(""):map(string.byte)
    for _ = 2, iterations do
        ui = crypto.hmac(algo, pass, ui, true)
        for i = 1, #result do
            result[i] ~= ui:byte(i)
        end
    end
    return result:map(string.char):concat("")
end
assert(pbkdf2_hmac("sha1", "plnlrtfpijpuhqylxbgqiiyipieyxvfsavzgxbbcfusqkozwpngsyejqlmjsytrmd", "\xA0\x09\xC1\xA4\x85\x91\x2C\x6A\xE6\x30\xD3\xE7\x44\x24\x0B\x04", 1000):tohex() == "17eb4014c8c461c300e9b61518b9a18bdd668c1b")

function sasl_scram(algo, user, pass, client_nonce, server_first_message)
    local gs2_header = "n,,"
    local client_first_bare = "n="..user..",r="..client_nonce

    local server_nonce, salt
    local iterations = 4096
    for server_first_message:split(",") as prop do
        if prop:sub(1, 2) == "r=" then
            server_nonce = prop:sub(3)
        elseif prop:sub(1, 2) == "s=" then
            salt = prop:sub(3)
        elseif prop:sub(1, 2) == "i=" then
            iterations = tonumber(prop:sub(3))
        end
    end

    local auth_message = client_first_bare .. "," .. server_first_message .. ",c=" .. base64.encode(gs2_header) .. ",r=" .. server_nonce
    local salted_pass = pbkdf2_hmac(algo, pass, base64.decode(salt), iterations)
    local client_key = crypto.hmac(algo, salted_pass, "Client Key", true)
    local stored_key = crypto[algo](client_key, true)

    local client_signature = crypto.hmac(algo, stored_key, auth_message, true)
    local client_proof = client_key:split(""):map(|k, v| -> string.char(v:byte() ~ client_signature:byte(k)), true):concat("")
    local client_final_message = "c=" .. base64.encode(gs2_header) .. ",r=" .. server_nonce .. ",p=" .. base64.encode(client_proof)

    local server_key = crypto.hmac(algo, salted_pass, "Server Key", true)
    local server_signature = crypto.hmac(algo, server_key, auth_message, true)
    local server_final_message = "v=" .. base64.encode(server_signature)

    return client_final_message, server_final_message
end
assert(sasl_scram("sha1", "user", "pencil", "fyko+d2lbbFgONRv9qkxdawL", "r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,s=QSXCR+Q6sek8bf92,i=4096") == "c=biws,r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,p=v0X8v3Bz2T0CJGbJQyF0X+HI4Ts=")

function pgpack(msg)
    return string.pack(">I4", #msg + 4) .. msg
end

function pgrecv(s)
    local msg = s:recv()
    local payload_len = ">I4":unpack(msg, 2)
    payload_len += 1
    while #msg < payload_len do
        msg ..= s:recv()
    end
    if #msg > payload_len then
        s:unrecv(msg:sub(payload_len + 1))
        msg = msg:sub(1, payload_len)
    end
    local type = msg[1]
    msg = msg:sub(6)
    if type == "E" then
        local i = 1
        local err = {}
        while i < #msg do
            err[msg[i]], i = ">z":unpack(msg, i + 1)
        end
        error($"{err.M} ({err.C})")
    end
    return type, msg
end

function pgauth(s, user, pass, db)
    if not db then
        db = user
    end

    s:send(pgpack(">I4zzzzI1":pack(0x30000, "user", user, "database", db, 0)))

    -- Recv AuthenticationSASL
    local magic, data = pgrecv(s)
    assert(magic == "R")
    local auth_req_type = ">I4":unpack(data)
    assert(auth_req_type == 10) -- SASL
    assert("SCRAM-SHA-256" in data:sub(5):split("\x00"))

    -- SASLInitialResponse
    local client_nonce = base64.encode(crypto.random())
    s:send("p"..pgpack(">zs4":pack("SCRAM-SHA-256", "n,,n="..user..",r="..client_nonce)))
    magic, data = pgrecv(s)
    assert(data:sub(1, 4) == "\x00\x00\x00\x0b")
    local client_final_message, server_final_message = sasl_scram("sha256", user, pass, client_nonce, data:sub(5))
    s:send("p"..pgpack(client_final_message))

    -- Recv AuthenticationSASLFinal
    magic, data = pgrecv(s)
    assert(magic == "R")
    assert(data == "\x00\x00\x00\x0c"..server_final_message)

    -- Recv AuthenticationOk
    magic, data = pgrecv(s)
    assert(magic == "R")
    assert(data == "\x00\x00\x00\x00")
end

function pgquery(s, query, ...args)
    s:send("P"..pgpack(">zzI2":pack("", query, 0)))
    --s:send("H\x00\x00\x00\x04")

    local Bind = ">zzI2I2":pack("", "", 0, #args)
    for args as arg do
        Bind ..= ">s4":pack(arg)
    end
    Bind ..= "\x00\x00"
    s:send("B"..pgpack(Bind))
    --s:send("H\x00\x00\x00\x04")

    s:send("D"..pgpack("P\x00")) -- Optional, requesting description
    --s:send("H\x00\x00\x00\x04")

    s:send("E"..pgpack(">zI4":pack("", 0)))
    --s:send("H\x00\x00\x00\x04")

    s:send("S\x00\x00\x00\x04")

    assert(pgrecv(s) == "1")
    assert(pgrecv(s) == "2")

    local magic, data = pgrecv(s)
    assert(magic == "T")
    local cols = {}
    local i = 3
    while i <= #data do
        local name, taboid, attr, oid, typlen, atttypmod, isbin
        name, taboid, attr, oid, typlen, atttypmod, isbin, i = ">zI4I2I4I2I4I2":unpack(data, i)
        cols:insert({
            name = name,
            parse = switch oid do
                case 20, 21, 23 -> tonumber
                default -> |x| -> x
            end,
        })
    end

    local rows = {}
    while true do
        magic, data = pgrecv(s)
        if magic ~= "D" then
            break
        end
        i = 3
        local row = {}
        local colid = 0
        while i <= #data do
            local col = cols[++colid]
            local val
            val, i = ">s4":unpack(data, i)
            row[col.name] = col.parse(val)
        end
        rows:insert(row)
    end
    assert(magic == "C")

    magic, data = pgrecv(s)
    assert(magic == "Z")

    return rows
end
